{
  "name": "iracing-tire-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Research lab for an empirically validated iRacing tire-state model: read IBT, export, replay, measure error.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "tire-lab": "dist/cli/index.js"
  },
  "exports": {
    "./ibt": {
      "types": "./dist/ibt/index.d.ts",
      "default": "./dist/ibt/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    },
    "./replay": {
      "types": "./dist/replay/index.d.ts",
      "default": "./dist/replay/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./chart": {
      "types": "./dist/chart/index.d.ts",
      "default": "./dist/chart/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "check:package": "node scripts/checkPackage.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "node scripts/channelsDoc.ts",
    "vendor": "node scripts/vendorIrdashies.ts",
    "tire-lab": "node src/cli/index.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.7.0",
    "yaml": "^2.9.1"
  }
}
